@startuml
skinparam monochrome false
skinparam shadowing false
skinparam dpi 150
skinparam defaultFontName "Helvetica, Arial, sans-serif"
skinparam defaultFontSize 12
skinparam roundCorner 8
skinparam arrowThickness 2

' Styling
skinparam rectangle {
    BackgroundColor #F8FAFC
    BorderColor #1E293B
    BorderThickness 1.8
}

skinparam note {
    BackgroundColor #FEF9C3
    BorderColor #CA8A04
    BorderThickness 1.2
    FontSize 11
}

skinparam arrow {
    Color #1E293B
    FontSize 11
}

' Primary Step: Data Loading
rectangle "**Data Loading**\nNomihsa2024 Timber Dataset\n<i>(4,000 images, 8 defect classes)</i>" as DataLoading #E0F2FE

' Group of Operations: Preprocessing (box with dotted borders)
rectangle "<b>Preprocessing</b>" as PreprocessingFrame #line:1E293B;line.dotted;back:FAFAFA {
    rectangle "Black Border Cropping\n<i>(Otsu Threshold & Morph. Closing)</i>" as P1 #FFFFFF
    rectangle "Resolution Downscaling\n<i>(0.5x Area Interpolation)</i>" as P2 #FFFFFF
    rectangle "Coordinate Transform & Size Gate\n<i>(Preserve thin defects: min 2px / 12px²)</i>" as P3 #FFFFFF

    P1 -[#1E293B]-> P2
    P2 -[#1E293B]-> P3
}

' Primary Step: Data Splitting
rectangle "**Data Splitting**\nIterative Stratification\n<i>(80% Train / 10% Val / 10% Test)</i>" as DataSplitting #E0F2FE

' Primary Step: Majority Plank Balancing
rectangle "**Majority Plank Balancing**\n<i>(Drop 35% majority-only planks)</i>" as MajorityBalancing #E0F2FE

' Primary Step: Data Augmentation
rectangle "**Data Augmentation**\nMinority Defect Synthesis\n<i>(Target minority ratio: 33%)</i>" as DataAugmentation #E0F2FE

' Primary Step: Training
rectangle "**Training**\nMulti-Paradigm Model Training\n<i>(Effective-Number Class Weighting)</i>" as Training #E0F2FE

' Primary Step: Validation
rectangle "**Validation**\nOperating-Point Evaluation\n<i>(Confidence Calibration)</i>" as Validation #E0F2FE

' Primary Step: Analysis
rectangle "**Analysis**\nPerformance Matrices & Figures\n<i>(Bonferroni CIs & Statistical Tests)</i>" as Analysis #DCFCE7

' Connections: Data Loading -> Preprocessing -> Data Splitting
DataLoading -[#1E293B]-> P1
P3 -[#1E293B]-> DataSplitting

' Lines out of Data Splitting:
' 1. Line to Majority Plank Balancing labeled 80%
DataSplitting -[#1E293B]-> MajorityBalancing : <b>80%</b>

' Line from Majority Plank Balancing to Data Augmentation
MajorityBalancing -[#1E293B]-> DataAugmentation

' 2. Line directly to Training labeled 10%
DataSplitting -[#1E293B]-> Training : <b>10%</b>

' 3. Line directly to Validation
DataSplitting -[#1E293B]-> Validation : <b>10%</b>

' 4 dotted lines from Data Augmentation to Training (base + each technique)
DataAugmentation .[#475569].> Training : Base (Baseline / No Aug)
DataAugmentation .[#475569].> Training : Albumentations (Photometric)
DataAugmentation .[#475569].> Training : BoxAug Standard (Cut & Paste)
DataAugmentation .[#475569].> Training : BoxAug LibCom (Neural Harmonization)

' Normal line joining Data Augmentation and Training, with models UML comment
DataAugmentation -[#1E293B]-> Training
note on link
  <b>Models Used:</b>
  • <b>Cascade R-CNN</b> <i>(Two-Stage, ResNet-50 + FPN)</i>
  • <b>YOLO26m</b> <i>(One-Stage, Anchor-Free Dual-Head)</i>
  • <b>RF-DETR-m</b> <i>(Transformer, NAS)</i>
end note

' Line from Training to Validation with metrics note and models note
Training -[#1E293B]-> Validation
note on link
  <b>Metrics Used:</b>
  • mAP@0.5 & mAP@0.5:0.95
  • Precision, Recall, F1-Score
  • Per-Class AP@0.5 (Wilson CIs)
  • Calibration Threshold Sweep
end note

note right of Validation
  <b>Models Evaluated:</b>
  • <b>RF-DETR-m</b> <i>(conf = 0.20)</i>
  • <b>YOLO26m</b> <i>(conf = 0.30)</i>
  • <b>Cascade R-CNN</b> <i>(conf = 0.50)</i>
end note

' Line from Validation to Analysis
Validation -[#1E293B]-> Analysis

@enduml
